name: 🔍 AlphaEdge SSH Test
on:
  workflow_dispatch:

jobs:
  ssh-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: '🔑 Setup SSH Key'
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.UBUNTU_SSH_KEY }}

      - name: '🔍 Test SSH + Run Mini Scan'
        env:
          VM_IP: ${{ vars.VM_PUBLIC_IP }}
          LINUX_ADMIN_USER: ${{ vars.LINUX_ADMIN_USER }}
        run: |
          mkdir -p ~/.ssh
          echo "StrictHostKeyChecking no" >> ~/.ssh/config
          echo "UserKnownHostsFile /dev/null"  >> ~/.ssh/config

          echo "========================================"
          echo "1. SSH CONNECTIVITY"
          echo "========================================"
          ssh -o ConnectTimeout=10 ${LINUX_ADMIN_USER}@${VM_IP} \
            "echo '✅ Connected as $(whoami) on $(hostname)' && uname -a"

          echo ""
          echo "========================================"
          echo "2. INVOKING BENCHMARK (scan only, Ubuntu, this IP)"
          echo "========================================"
          chmod +x multi_os_benchmark.sh
          AUDIT_PASS=dummy \
          ./multi_os_benchmark.sh \
            --headless \
            --cloud     huaweicloud \
            --mode      scan \
            --profile   cis \
            --target-os ubuntu \
            --target-ip "$VM_IP" \
            --targets   all
