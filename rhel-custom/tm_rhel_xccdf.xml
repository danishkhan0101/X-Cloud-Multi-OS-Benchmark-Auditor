<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_com.tm_benchmark_lsb" resolved="1">
  <status date="2026-04-23">accepted</status>
  <title>Telekom Malaysia (TM) Unified Baseline - RHEL Standardized</title>
  <description>Official XCCDF Benchmark for TM LSB compliance. Validated for Red Hat Enterprise Linux 9.</description>
  <version>1.2</version>

  <Profile id="xccdf_com.tm_profile_lsb">
    <title>TM LSB Complete Profile (RHEL Standard)</title>
    <description>Evaluates 20 Technical LSB rules across 7 categories.</description>
    <select idref="xccdf_com.tm_rule_14" selected="true"/>
