  <!-- ============================================= -->
  <!-- GROUP 1: Patch Management                     -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_patch">
    <title>Patch Management</title>
    <description>Verifies system packages are current.</description>

    <Rule id="xccdf_com.tm_rule_14" selected="true" severity="low">
      <title>LSB14: Patch Status Validated</title>
      <description>Verify trace file for system patches.</description>
      <ident system="http://cce.mitre.org">CCE-TM-14</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:14"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 2: Mandatory Access Control              -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_mac">
    <title>Mandatory Access Control</title>
    <description>SELinux installation and enforcing-mode checks.</description>

    <Rule id="xccdf_com.tm_rule_25" selected="true" severity="high">
      <title>LSB25: SELinux Installed</title>
      <description>Ensure SELinux core packages (libselinux) are installed.</description>
      <rationale>Mandatory Access Control (MAC) limits privileges.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-25</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:25"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_26" selected="true" severity="high">
      <title>LSB26: SELinux Enforcing</title>
      <description>Ensure SELinux mode is explicitly set to enforcing.</description>
      <rationale>SELinux must actively block policy violations, not just log them.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-26</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:26"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 3: Host Firewall                         -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_firewall">
    <title>Host Firewall</title>
    <description>iptables enablement and default-deny posture.</description>

    <Rule id="xccdf_com.tm_rule_27" selected="true" severity="high">
      <title>LSB27: iptables Active</title>
      <description>Ensure iptables services are installed and active.</description>
      <rationale>Host-based firewalls protect against internal lateral movement.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-27</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:27"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_29" selected="true" severity="high">
      <title>LSB29: Firewall Default DROP</title>
      <description>Ensure iptables drops unauthorized INPUT, FORWARD, and OUTPUT traffic.</description>
      <rationale>A default deny posture is required by TM policy.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-29</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:29"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 4: System Configuration                  -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_sysconfig">
    <title>System Configuration</title>
    <description>Timezone and filesystem restrictions.</description>

    <Rule id="xccdf_com.tm_rule_15" selected="true" severity="medium">
      <title>LSB15: Set Timezone</title>
      <description>Set MYT timezone.</description>
      <ident system="http://cce.mitre.org">CCE-TM-15</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:15"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_20" selected="true" severity="medium">
      <title>LSB20: Disable Filesystems</title>
      <description>Disable cramfs, etc.</description>
      <ident system="http://cce.mitre.org">CCE-TM-20</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:20"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 5: SSH Hardening                         -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_ssh">
    <title>SSH Hardening</title>
    <description>Banner and root login restrictions.</description>

    <Rule id="xccdf_com.tm_rule_19" selected="true" severity="low">
      <title>LSB19: SSH Banner</title>
      <description>Configure TM banner.</description>
      <ident system="http://cce.mitre.org">CCE-TM-19</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:19"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_28" selected="true" severity="high">
      <title>LSB28: Disable Root SSH</title>
      <description>PermitRootLogin no.</description>
      <ident system="http://cce.mitre.org">CCE-TM-28</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:28"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 6: Logging & Auditing                    -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_logging">
    <title>Logging &amp; Auditing</title>
    <description>Auditd and centralized log forwarding.</description>

    <Rule id="xccdf_com.tm_rule_39" selected="true" severity="high">
      <title>LSB39: Install Auditd</title>
      <description>Install auditd.</description>
      <ident system="http://cce.mitre.org">CCE-TM-39</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:39"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_41" selected="true" severity="high">
      <title>LSB41: Rsyslog Forwarding</title>
      <description>Rsyslog NGSIEM.</description>
      <ident system="http://cce.mitre.org">CCE-TM-41</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_rhel_rules.xml" name="oval:tm.rhel:def:41"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 7: Prohibited Services                   -->
