  <Group id="xccdf_com.tm_group_all">
    <title>TM Hardening Rules</title>
    <description>Detailed technical checks for RHEL 9 infrastructure.</description>
    
    <Rule id="xccdf_com.tm_rule_14" selected="true" severity="low"><title>LSB14: Patch Status Validated</title><description>Verify trace file for system patches.</description><ident system="http://cce.mitre.org">CCE-TM-14</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:14"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_25" selected="true" severity="high"><title>LSB25: SELinux Installed</title><description>Ensure SELinux core packages (libselinux) are installed.</description><rationale>Mandatory Access Control (MAC) limits privileges.</rationale><ident system="http://cce.mitre.org">CCE-TM-25</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:25"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_26" selected="true" severity="high"><title>LSB26: SELinux Enforcing</title><description>Ensure SELinux mode is explicitly set to enforcing.</description><rationale>SELinux must actively block policy violations, not just log them.</rationale><ident system="http://cce.mitre.org">CCE-TM-26</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:26"/></check></Rule>
    
    <Rule id="xccdf_com.tm_rule_27" selected="true" severity="high"><title>LSB27: iptables Active</title><description>Ensure iptables services are installed and active.</description><rationale>Host-based firewalls protect against internal lateral movement.</rationale><ident system="http://cce.mitre.org">CCE-TM-27</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:27"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_29" selected="true" severity="high"><title>LSB29: Firewall Default DROP</title><description>Ensure iptables drops unauthorized INPUT, FORWARD, and OUTPUT traffic.</description><rationale>A default deny posture is required by TM policy.</rationale><ident system="http://cce.mitre.org">CCE-TM-29</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:29"/></check></Rule>

    <Rule id="xccdf_com.tm_rule_15" selected="true" severity="medium"><title>LSB15: Set Timezone</title><description>Set MYT timezone.</description><ident system="http://cce.mitre.org">CCE-TM-15</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:15"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_19" selected="true" severity="low"><title>LSB19: SSH Banner</title><description>Configure TM banner.</description><ident system="http://cce.mitre.org">CCE-TM-19</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:19"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_20" selected="true" severity="medium"><title>LSB20: Disable Filesystems</title><description>Disable cramfs, etc.</description><ident system="http://cce.mitre.org">CCE-TM-20</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:20"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_28" selected="true" severity="high"><title>LSB28: Disable Root SSH</title><description>PermitRootLogin no.</description><ident system="http://cce.mitre.org">CCE-TM-28</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:28"/></check></Rule>
    
    <Rule id="xccdf_com.tm_rule_30" selected="true" severity="high"><title>LSB30: Remove Squid</title><description>No proxy.</description><ident system="http://cce.mitre.org">CCE-TM-30</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:30"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_31" selected="true" severity="high"><title>LSB31: Remove Dovecot</title><description>No mail.</description><ident system="http://cce.mitre.org">CCE-TM-31</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:31"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_32" selected="true" severity="high"><title>LSB32: Remove FTP</title><description>No FTP (vsftpd).</description><ident system="http://cce.mitre.org">CCE-TM-32</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:32"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_33" selected="true" severity="medium"><title>LSB33: Remove DNS</title><description>No bind.</description><ident system="http://cce.mitre.org">CCE-TM-33</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:33"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_34" selected="true" severity="medium"><title>LSB34: Remove DHCP</title><description>No DHCP server.</description><ident system="http://cce.mitre.org">CCE-TM-34</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:34"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_35" selected="true" severity="high"><title>LSB35: Remove Telnet</title><description>No Telnet.</description><ident system="http://cce.mitre.org">CCE-TM-35</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:35"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_36" selected="true" severity="high"><title>LSB36: Remove RSH</title><description>No RSH.</description><ident system="http://cce.mitre.org">CCE-TM-36</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:36"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_37" selected="true" severity="low"><title>LSB37: Remove LDAP</title><description>No OpenLDAP clients.</description><ident system="http://cce.mitre.org">CCE-TM-37</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:37"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_38" selected="true" severity="medium"><title>LSB38: Remove SNMP</title><description>No net-snmp.</description><ident system="http://cce.mitre.org">CCE-TM-38</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:38"/></check></Rule>
    
    <Rule id="xccdf_com.tm_rule_39" selected="true" severity="high"><title>LSB39: Install Auditd</title><description>Install auditd.</description><ident system="http://cce.mitre.org">CCE-TM-39</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:39"/></check></Rule>
    <Rule id="xccdf_com.tm_rule_41" selected="true" severity="high"><title>LSB41: Rsyslog Forwarding</title><description>Rsyslog NGSIEM.</description><ident system="http://cce.mitre.org">CCE-TM-41</ident><check system="http://oval.mitre.org/XMLSchema/oval-definitions-5"><check-content-ref href="/tmp/tm_rhel9_rules.xml" name="oval:tm.rhel9:def:41"/></check></Rule>
  </Group>
