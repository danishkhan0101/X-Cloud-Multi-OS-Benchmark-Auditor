<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_com.tm_benchmark_lsb" resolved="1">
  <status date="2026-04-08">accepted</status>
  <title>Telekom Malaysia (TM) Unified Baseline</title>
  <description>Official XCCDF Benchmark for TM LSB compliance. Validated for Ubuntu.</description>
  <version>1.0</version>

  <Profile id="xccdf_com.tm_profile_lsb">
    <title>TM LSB Complete Profile</title>
    <description>Evaluates 19 Technical LSB rules across 7 categories.</description>
    <select idref="xccdf_com.tm_rule_14" selected="true"/>
    <select idref="xccdf_com.tm_rule_15" selected="true"/>
    <select idref="xccdf_com.tm_rule_16" selected="true"/>
    <select idref="xccdf_com.tm_rule_19" selected="true"/>
    <select idref="xccdf_com.tm_rule_20" selected="true"/>
    <select idref="xccdf_com.tm_rule_25" selected="true"/>
    <select idref="xccdf_com.tm_rule_27" selected="true"/>
    <select idref="xccdf_com.tm_rule_28" selected="true"/>
    <select idref="xccdf_com.tm_rule_29" selected="true"/>
    <select idref="xccdf_com.tm_rule_30" selected="true"/>
    <select idref="xccdf_com.tm_rule_31" selected="true"/>
    <select idref="xccdf_com.tm_rule_32" selected="true"/>
    <select idref="xccdf_com.tm_rule_33" selected="true"/>
    <select idref="xccdf_com.tm_rule_34" selected="true"/>
    <select idref="xccdf_com.tm_rule_35" selected="true"/>
    <select idref="xccdf_com.tm_rule_36" selected="true"/>
    <select idref="xccdf_com.tm_rule_37" selected="true"/>
    <select idref="xccdf_com.tm_rule_38" selected="true"/>
    <select idref="xccdf_com.tm_rule_39" selected="true"/>
    <select idref="xccdf_com.tm_rule_40" selected="true"/>
    <select idref="xccdf_com.tm_rule_41" selected="true"/>
  </Profile>

  <!-- ============================================= -->
  <!-- GROUP 1: Patch Management                     -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_patch">
    <title>Patch Management</title>
    <description>Verifies system packages are current.</description>

    <Rule id="xccdf_com.tm_rule_14" selected="true" severity="low">
      <title>LSB14: Patch Status Validated</title>
      <description>Verify trace file for system patches.</description>
      <ident system="http://cce.mitre.org">CCE-TM-14</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:14"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 2: Mandatory Access Control              -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_mac">
    <title>Mandatory Access Control</title>
    <description>AppArmor enforcement checks.</description>

    <Rule id="xccdf_com.tm_rule_25" selected="true" severity="high">
      <title>LSB25/26: AppArmor Enforced</title>
      <description>Ensure AppArmor (Ubuntu SELinux equivalent) is installed.</description>
      <rationale>Mandatory Access Control (MAC) limits privileges.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-25</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:25"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 3: Host Firewall                         -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_firewall">
    <title>Host Firewall</title>
    <description>UFW enablement and default-deny posture.</description>

    <Rule id="xccdf_com.tm_rule_27" selected="true" severity="high">
      <title>LSB27: UFW Firewall Enabled</title>
      <description>Ensure Uncomplicated Firewall (UFW) is active.</description>
      <rationale>Host-based firewalls protect against internal lateral movement.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-27</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:27"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_29" selected="true" severity="high">
      <title>LSB29: Firewall Default DROP</title>
      <description>Ensure UFW drops unauthorized inbound traffic.</description>
      <rationale>A default deny posture is required by TM policy.</rationale>
      <ident system="http://cce.mitre.org">CCE-TM-29</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:29"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 4: System Configuration                  -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_sysconfig">
    <title>System Configuration</title>
    <description>Timezone and filesystem restrictions.</description>

    <Rule id="xccdf_com.tm_rule_15" selected="true" severity="medium">
      <title>LSB15: Set Timezone</title>
      <description>Set MYT timezone.</description>
      <ident system="http://cce.mitre.org">CCE-TM-15</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:15"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_20" selected="true" severity="medium">
      <title>LSB20: Disable Filesystems</title>
      <description>Disable cramfs, etc.</description>
      <ident system="http://cce.mitre.org">CCE-TM-20</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:20"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 5: SSH Hardening                         -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_ssh">
    <title>SSH Hardening</title>
    <description>Banner and root login restrictions.</description>

    <Rule id="xccdf_com.tm_rule_19" selected="true" severity="low">
      <title>LSB19: SSH Banner</title>
      <description>Configure TM banner.</description>
      <ident system="http://cce.mitre.org">CCE-TM-19</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:19"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_28" selected="true" severity="high">
      <title>LSB28: Disable Root SSH</title>
      <description>PermitRootLogin no.</description>
      <ident system="http://cce.mitre.org">CCE-TM-28</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:28"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 6: Logging & Auditing                    -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_logging">
    <title>Logging &amp; Auditing</title>
    <description>Auditd and centralized log forwarding.</description>

    <Rule id="xccdf_com.tm_rule_39" selected="true" severity="high">
      <title>LSB39: Install Auditd</title>
      <description>Install auditd.</description>
      <ident system="http://cce.mitre.org">CCE-TM-39</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:39"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_41" selected="true" severity="high">
      <title>LSB41: Rsyslog Forwarding</title>
      <description>Rsyslog NGSIEM.</description>
      <ident system="http://cce.mitre.org">CCE-TM-41</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:41"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 7: Prohibited Services                   -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_forbidden">
    <title>Prohibited Services</title>
    <description>Removal of disallowed network services.</description>

    <Rule id="xccdf_com.tm_rule_30" selected="true" severity="high">
      <title>LSB30: Remove Squid</title>
      <description>No proxy.</description>
      <ident system="http://cce.mitre.org">CCE-TM-30</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:30"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_31" selected="true" severity="high">
      <title>LSB31: Remove Dovecot</title>
      <description>No mail.</description>
      <ident system="http://cce.mitre.org">CCE-TM-31</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:31"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_32" selected="true" severity="high">
      <title>LSB32: Remove FTP</title>
      <description>No FTP.</description>
      <ident system="http://cce.mitre.org">CCE-TM-32</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:32"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_33" selected="true" severity="medium">
      <title>LSB33: Remove DNS</title>
      <description>No bind9.</description>
      <ident system="http://cce.mitre.org">CCE-TM-33</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:33"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_34" selected="true" severity="medium">
      <title>LSB34: Remove DHCP</title>
      <description>No DHCP.</description>
      <ident system="http://cce.mitre.org">CCE-TM-34</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:34"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_35" selected="true" severity="high">
      <title>LSB35: Remove Telnet</title>
      <description>No Telnet.</description>
      <ident system="http://cce.mitre.org">CCE-TM-35</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:35"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_36" selected="true" severity="high">
      <title>LSB36: Remove RSH</title>
      <description>No RSH.</description>
      <ident system="http://cce.mitre.org">CCE-TM-36</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:36"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_37" selected="true" severity="low">
      <title>LSB37: Remove LDAP</title>
      <description>No LDAP.</description>
      <ident system="http://cce.mitre.org">CCE-TM-37</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:37"/>
      </check>
    </Rule>

    <Rule id="xccdf_com.tm_rule_38" selected="true" severity="medium">
      <title>LSB38: Remove SNMP</title>
      <description>No SNMP.</description>
      <ident system="http://cce.mitre.org">CCE-TM-38</ident>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref href="/tmp/tm_ubuntu_rules.xml" name="oval:tm.ubuntu:def:38"/>
      </check>
    </Rule>
  </Group>

  <!-- ============================================= -->
  <!-- GROUP 8: Manual Verification Required          -->
  <!-- ============================================= -->
  <Group id="xccdf_com.tm_group_manual">
    <title>Manual Verification Required</title>
    <description>Baseline items requiring human verification. Not auto-remediated or auto-checked by this profile.</description>
  
    <Rule id="xccdf_com.tm_rule_16" selected="true" severity="medium" role="unscored">
      <title>LSB16: XDR / Endpoint Security Agent</title>
      <description>Install TM Extended Detection Response (XDR) or approved endpoint security agent via Self Service Portal or av.taskforce@tm.com.my. Manual verification required — not auto-remediated.</description>
      <ident system="http://cce.mitre.org">CCE-TM-16</ident>
    </Rule>
  
    <Rule id="xccdf_com.tm_rule_40" selected="true" severity="medium" role="unscored">
      <title>LSB40: Event Log Retention (1 year minimum)</title>
      <description>Configure event/audit log retention method and size for minimum 1-year retention, per LSB12 capacity planning. Manual verification required — not auto-remediated.</description>
      <ident system="http://cce.mitre.org">CCE-TM-40</ident>
    </Rule>
  </Group>

</Benchmark>
