# ======================================================
# MULTI-OS BENCHMARK AUDITOR - CONFIGURATION TEMPLATE
# ======================================================
# INSTRUCTIONS: 
# Rename this file to '.env' and fill in your Azure details.
# DO NOT commit the actual '.env' file to GitHub!

# --- Azure Infrastructure ---
AZURE_RG_NAME="Your_Resource_Group_Name"
AZURE_KV_NAME="Your_KeyVault_Name"
AZURE_KV_SECRET="Your_Secret_Name"

# --- Target Machine Credentials ---
LINUX_ADMIN_USER="ubuntu"
WINDOWS_ADMIN_USER="Your_Windows_Admin_User"
EXCLUDE_HOST_NAME="Your_Audit_Runner_Name"
